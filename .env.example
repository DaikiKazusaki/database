# このファイルをコピーして .env.local を作る：
#   cp .env.example .env.local
# 実際の値は部のパスワードマネージャか、Vercelの環境変数画面から取る。
# Vercel CLI が入っていれば `vercel env pull .env.local` で一括取得できる。

# Neonの接続文字列（Vercel > Storage、またはNeonのダッシュボードから）
DATABASE_URL=

# サイト全体を保護するBasic認証。この2つが未設定だと全ページが500を返す。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
